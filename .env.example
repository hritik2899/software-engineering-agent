# Core
MINION_ENV=dev
MINION_DATABASE_URL=sqlite+aiosqlite:///./minion.db
MINION_REDIS_URL=
MINION_WORKSPACE_ROOT=.minion/workspaces
MINION_CACHE_ROOT=.minion/cache
MINION_LOG_LEVEL=INFO
MINION_API_KEY=

# Agent: use "mock" first to run the complete system without a model key.
MINION_LLM_PROVIDER=mock
MINION_LLM_MODEL=gpt-5
OPENAI_API_KEY=
MINION_MAX_AGENT_STEPS=30
MINION_CONTEXT_RECENT_EVENTS=40
MINION_CONTEXT_MAX_CHARS=60000
MINION_CONTEXT_COMPACT_EVERY_EVENTS=50

# Execution: local | docker | docker_pool
# docker_pool is a warm-start single-tenant demo; docker is the safer per-task sandbox.
MINION_ENVIRONMENT_PROVIDER=local
MINION_DOCKER_IMAGE=minion-sandbox:latest
MINION_COMMAND_TIMEOUT_SECONDS=600
MINION_WARM_POOL_SIZE=2
MINION_RETAIN_FAILED_WORKSPACES=true

# Distributed control-plane reliability
MINION_MAX_CONCURRENT_TASKS=4
MINION_TASK_LEASE_SECONDS=45
MINION_HEARTBEAT_INTERVAL_SECONDS=10
MINION_RECOVERY_SCAN_INTERVAL_SECONDS=15

# Repository defaults
MINION_DEFAULT_REPO_URL=https://github.com/octocat/Hello-World.git
MINION_DEFAULT_BASE_BRANCH=main

# GitHub private clone/push + PR publishing (kept outside the LLM tool layer)
GITHUB_TOKEN=
MINION_GITHUB_API_URL=https://api.github.com

# Shared repository+commit context index
MINION_CODE_INDEX_ENABLED=true
MINION_CODE_INDEX_MAX_FILES=3000
MINION_CODE_INDEX_MAX_FILE_BYTES=300000
