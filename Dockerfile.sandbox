FROM python:3.12-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       git ripgrep curl build-essential \
       nodejs npm \
       openjdk-17-jdk-headless maven gradle \
       golang-go \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["sleep", "infinity"]
